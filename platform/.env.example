# Copy to .env and edit. `.env` is gitignored; this file is committed.
#
# EVERY setting is an environment variable, with no hostname or credential hardcoded
# anywhere in the code. That is what makes the platform deployable to any VPS or cloud
# without a rewrite — see docs/POKER_ARCHITECTURE.md, "Portability".
#
# Defaults below match docker-compose.yml. In production, override all of them.

# ── ClickHouse (analytics store) ─────────────────────────────────────────────
# Managed alternatives that need only these four values changed:
#   ClickHouse Cloud · Altinity.Cloud · Yandex Managed ClickHouse
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8124
CLICKHOUSE_USER=poker
CLICKHOUSE_PASSWORD=poker
# Prefix on every ClickHouse database name (core, staging, intermediate, marts, _meta).
# Leave EMPTY for the real analysis data. `make test-all` and `make seed` set it to `test_`
# themselves so synthetic hands never land beside real ones; dbt reads the same variable.
CLICKHOUSE_DB_PREFIX=

# ── PostgreSQL (system of record) ────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5434
POSTGRES_USER=poker
POSTGRES_PASSWORD=poker
POSTGRES_DB=poker

# ── Redis (cache — nothing here is authoritative) ────────────────────────────
REDIS_URL=redis://localhost:6380/0
STATS_CACHE_TTL_SECONDS=300

# ── Object storage (S3 API) ──────────────────────────────────────────────────
# Works unchanged against MinIO, AWS S3, Yandex Object Storage, Cloudflare R2, Backblaze B2.
# Only the endpoint and credentials change.
S3_ENDPOINT=http://localhost:9010
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_RAW_BUCKET=poker-raw
S3_REGION=us-east-1

# ── Kafka (ingestion bus, Kafka wire protocol) ───────────────────────────────
# Works unchanged against self-hosted Kafka, Redpanda, MSK, Confluent, Yandex Managed Kafka.
KAFKA_BOOTSTRAP=127.0.0.1:9094
KAFKA_UPLOADS_TOPIC=hands.uploads.v1
KAFKA_BULK_TOPIC=hands.bulkimport.v1
KAFKA_DEADLETTER_TOPIC=hands.deadletter.v1
KAFKA_CONSUMER_GROUP=parser-workers

# ── Auth ─────────────────────────────────────────────────────────────────────
# MUST be replaced in any non-local environment. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-not-a-real-secret-change-me
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=14

# ── Ingestion tuning ─────────────────────────────────────────────────────────
# One INSERT = one ClickHouse part. Small batches cause TOO_MANY_PARTS; this is a
# correctness constraint, not an optimization.
INSERT_BATCH_SIZE=5000
MAX_UPLOAD_BYTES=209715200
